# Harness image for the #1007 stage-2 EXTERNAL agent gate, third leg: the
# OpenAI Agents SDK driving imp-server over the RESPONSES dialect
# (/v1/responses). That is the one dialect the other two legs do not exercise —
# aider speaks chat-completions, Claude Code speaks /v1/messages — and it is
# roadmap gap 10's remaining leg.
#
# Kept separate from the runtime image (which ships no Python) so the gate is
# self-contained; deps are baked at build time (network available then) so the
# test run itself is offline.
#
# Build:  docker build -f tools/Dockerfile.agents-sdk -t imp:agents-sdk tools/
# Usage:  see the `test-agents-external` Makefile target.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Pin a known-good line: the SDK's default model path IS the Responses API,
# which is exactly what this leg is here to exercise.
RUN pip install --no-cache-dir "openai-agents==0.2.3"

WORKDIR /work
