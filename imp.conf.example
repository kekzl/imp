# imp.conf example: the keys most runs touch, every one commented out at its default,
# so a copy of this file changes nothing until a line is uncommented.
# All 152 keys with full comments: imp.conf.reference
#
# Loading precedence (first non-empty wins):
#   1. --config <path>              CLI flag
#   2. $IMP_CONFIG                  environment variable
#   3. ./imp.conf                   working-dir relative
#   4. ~/.config/imp/imp.conf       user config directory
#   5. embedded defaults            (no file, the values below)
#
# Per-run overrides on top via:
#   imp-cli --set kv_cache.dtype=fp8 --set runtime.cuda_graphs=never ...

[runtime]
# Context length; 0 = auto (capped at 128K, VRAM and the model's declared context).
# max_seq_len          = 0
# Concurrent sequences per decode batch; 0 = auto from the weight footprint.
# max_batch_size       = 0
# Hard VRAM budget for this process in MiB (0 = uncapped); --vram-budget overrides.
# vram_budget_mb       = 0
# Prefill chunk: -1 = per-arch default (2048 where supported), 0 = no chunking.
# prefill_chunk_size   = -1
# CUDA graph capture: "auto" per model, "always", "never".
# cuda_graphs          = "auto"
# Bit-identical greedy output across runs (temp=0 evals); costs throughput.
# deterministic        = false
# Deterministic GEMM only (cuBLASLt no_reduce_split), implied by deterministic.
# deterministic_gemm   = false
# Cap on reasoning tokens per request, whatever max_tokens is. 0 = no cap.
# think_max_tokens = 32768
# Drop the Qwen3-VL vision tower / Gemma-4 audio tower at init (parts answer 400).
# no_vision            = false
# no_audio             = false
# Qwen3-VL image-token budget; a larger image is scaled down. 4096 ~ 1024x1024.
# vision_max_patches   = 4096
# Two tiny warmup requests at init; false trades first-request reproducibility for init time.
# warmup               = true

[kv_cache]
# KV element type: "auto" (FP16, FP8 where measured safe), "fp16", fp8|int8|int4|nvfp4|mxfp4.
# dtype                       = "auto"
# Pin the KV pool to this many blocks; 0 = size it from the VRAM budget.
# max_blocks                  = 0
# Pinned host RAM (MiB) the prefix cache spills reclaimed blocks to. 0 = off.
# host_spill_mb               = 0

[attention]
# Sparse decode attention budget in tokens: -1 = auto (4096 on measured archs), 0 = off.
# sparse_topk_tokens   = -1

[speculative]
# MTP-head draft length: -1 = auto, 0 = off, > 0 = fixed depth.
# mtp_k                = -1
# n-gram (prompt-lookup) drafting from the request's own text, no draft model.
# ngram                = true

[moe]
# Share of free VRAM (percent, 1..90) the expert LRU cache may claim.
# expert_cache_budget_pct = 15
# Host expert tier cap in MiB: 0 = auto from host RAM, -1 = off.
# host_expert_pool_mib = 0
# Pin host-resident experts in page-locked memory (prefill transfers only).
# pin_host_experts     = false

[server]
# Reuse KV blocks for shared prompt prefixes (system prompts, multi-turn history).
# prefix_cache         = true
# Swap to a requested model instead of answering 404 (in-flight requests drain first).
# model_swap           = true
# Seconds an idle "session_id" pin lives; 0 = no TTL.
# session_ttl_s        = 600
# OTLP/HTTP traces URL, e.g. http://localhost:4318/v1/traces; "" = off.
# otlp_endpoint = ""

[vram]
# Share of post-reserve VRAM the KV pool targets, clamped to [0.05, 1.0].
# kv_fraction       = 1.0

[warm_cache]
# Persist converted weight buffers so later boots skip the conversion.
# enabled              = true
# Cache directory; "" = $XDG_CACHE_HOME/imp/warm. Mount a volume there in containers.
# dir                  = ""

[rope]
# Runtime RoPE scaling override: "" = off (model metadata), "yarn", "linear".
# scaling     = ""
# Context-extension factor (> 1.0), e.g. 4.0 turns 32k into 128k.
# factor      = 1.0
# Native context the factor applies to; 0 = auto (model-declared).
# orig_ctx    = 0

[paths]
# Vision projector .gguf (Gemma-3, Mistral3); Qwen3-VL ships its tower inside.
# mmproj               = ""

[diagnostics]
# Process log level: debug | info | warn | error | fatal.
# log_level            = info
