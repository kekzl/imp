#!/bin/bash
# Two tiers: correctness (gtests, degen smoke, graphs ON/OFF) runs on any source change - CI
# has no GPU, so this is the only real-kernel correctness check. Throughput (perf gate) runs
# only when the diff can move a number (kernel/dispatch trees, .cu/.cuh, build def, baseline);
# else IMP_VERIFY_SKIP_PERF=1 (host decode drifts several percent between sessions).
# Paired A/B (make verify-ab, AUDIT_arch_2026 H-3) replaces the single-arm gate on kernel diffs
# (src/compute, src/exec): 8% single-arm threshold vs 2% mean paired delta; IMP_SKIP_AB=1 falls
# back. docker build skips when imp:test already has the tree fingerprint. Override: git push --no-verify.
set -uo pipefail

REMOTE="$1"
URL="$2"
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

SOURCE_RE='^(src/|include/|tools/|tests/|scripts/|CMakeLists\.txt|cmake/|.*\.cmake$)'
PERF_RE='^(src/(compute|exec|quant|runtime|model)/|.*\.(cu|cuh)$|cmake/|CMakeLists\.txt|tests/perf_baseline)'

# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
NEEDS_VERIFY=0
NEEDS_PERF=0
NEEDS_ROOFLINE=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ] && continue   # delete
    if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
        # New branch — diff against upstream merge-base or main
        BASE=$(git merge-base "$LOCAL_SHA" origin/main 2>/dev/null || echo "")
        [ -z "$BASE" ] && BASE=$(git rev-list --max-parents=0 "$LOCAL_SHA" | head -1)
    else
        BASE="$REMOTE_SHA"
    fi
    FILES=$(git diff --name-only "$BASE" "$LOCAL_SHA" 2>/dev/null || true)
    [ -z "$FILES" ] && continue
    # Docs can't move a number or break a kernel: excluding .md/.py/.hook (and tools/mutation/)
    # keeps a docs-only push from paying the full perf gate and reporting the host, not the change.
    # verify.sh invokes no .py at all (checked). .hook files are read only by make install-hooks.
    FILES=$(echo "$FILES" | grep -vE '\.(md|py|hook)$|^tools/mutation/' || true)
    # scripts/*.sh membership test lives in verify_touches.sh (single source read by both the
    # hook and its guard): right for verify.sh and the ctest-registered guard scripts, wrong for
    # the 17 scripts verify.sh's path never reaches (ci_static_gates, check-release, bench harnesses).
    FILES=$(echo "$FILES" | while read -r f; do
        case "$f" in
            scripts/*.sh) "$ROOT/scripts/verify_touches.sh" "$f" >/dev/null 2>&1 && echo "$f" ;;
            *) echo "$f" ;;
        esac
    done)
    [ -z "$FILES" ] && continue
    echo "$FILES" | grep -qE "$SOURCE_RE" && NEEDS_VERIFY=1
    echo "$FILES" | grep -qE "$PERF_RE"   && NEEDS_PERF=1
    echo "$FILES" | grep -qE '^src/(compute|exec)/' && NEEDS_ROOFLINE=1
done

if [ "$NEEDS_VERIFY" -eq 0 ]; then
    echo "pre-push: no source changes, skipping verify"
    exit 0
fi

# Cheap static gates first (seconds, no GPU, no build): everything that would otherwise
# surface only in CI, one full roundtrip after the push already ran.
# Only `kernels` (needs a built artifact) and `hygiene` (subsumes citations via
# check-release.sh) stay CI-side.
if [ -x "$ROOT/scripts/ci_static_gates.sh" ] || [ -f "$ROOT/scripts/ci_static_gates.sh" ]; then
    if ! bash "$ROOT/scripts/ci_static_gates.sh" filesize lanes entrypoint alloc launchguards layering docs citations; then
        echo "pre-push: static gates failed (see above) - fix or push --no-verify"
        exit 1
    fi
fi

# Both tiers below run kernels, so neither can judge anything on a busy card. Checked after
# the "no source changes" exit above: a docs-only push must not wait for a card it never touches.
# Guarded: an installed hook may predate this script and must still run rather than die on it.
if [ -x "$ROOT/scripts/require_free_gpu.sh" ]; then
    "$ROOT/scripts/require_free_gpu.sh" "pre-push" || exit 1
fi

# Roofline (per-kernel %-of-peak, tools/roofline/) has no automated arm: CI has no GPU runner
# and roofline.yml only re-parses committed history, so a kernel diff compares against nothing
# unless someone measures. Reminder names the age of the newest run (AUDIT_arch_2026 H-2).
if [ "$NEEDS_ROOFLINE" -eq 1 ] && [ -s "$ROOT/tools/roofline/history/index.jsonl" ]; then
    _rl_run="$(tail -1 "$ROOT/tools/roofline/history/index.jsonl" | sed -n 's/.*"run_id": *"\([^"]*\)".*/\1/p')"
    _rl_date="$(echo "$_rl_run" | sed -n 's/^[0-9a-f]*_\([0-9]\{8\}\)_.*/\1/p')"
    _rl_age=""
    if [ -n "$_rl_date" ]; then
        _rl_age="$(( ( $(date -u +%s) - $(date -u -d "$_rl_date" +%s 2>/dev/null || date -u +%s) ) / 86400 )) days old"
    fi
    echo "pre-push: diff touches src/compute or src/exec; the roofline history's newest run is"
    echo "          ${_rl_run:-none} (${_rl_age:-age unknown}). Nothing measures it for you: run"
    echo "          'make roofline-measure && make roofline-regress' if this diff should move a kernel class."
fi

if [ "$NEEDS_PERF" -eq 1 ]; then
    # Kernel paths get the paired A/B (2% against origin/main, ~5min) and skip the single-arm perf
    # gate, which cannot resolve below the host's own 4-8% session drift.
    # Other measured paths (runtime, model, quant, cmake) keep the single-arm gate: their changes
    # move a number rarely, and the A/B would cost every push 5min for it.
    if [ "$NEEDS_ROOFLINE" -eq 1 ] && [ "${IMP_SKIP_AB:-0}" != "1" ]; then
        echo "pre-push: kernel paths changed → make verify-fast (correctness) + paired A/B (make verify-ab)"
        IMP_VERIFY_SKIP_PERF=1 make -s verify-fast || exit 1
        exec make -s verify-ab
    fi
    echo "pre-push: source changes touch the measured paths → make verify-fast (with perf gate)"
    exec make -s verify-fast
fi

echo "pre-push: source changes outside the measured paths → make verify-fast (no perf gate)"
echo "          run the perf gate anyway with: make verify-fast"
export IMP_VERIFY_SKIP_PERF=1
exec make -s verify-fast
