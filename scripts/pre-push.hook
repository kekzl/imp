#!/bin/bash
# pre-push hook: gate pushes on scripts/verify.sh fast.
#
# Two tiers, because the two halves of verify-fast answer different questions:
#
#   correctness (gtests, degeneration smoke, graphs ON/OFF sanity)
#       runs whenever a source file changed. CI has no GPU runner, so this local
#       run is the only thing in the project that ever puts a CUDA kernel in
#       front of a correctness check.
#
#   throughput (the perf gate: 3 benched processes, ~half the wall clock)
#       runs only when the diff can actually move a number: the kernel and
#       dispatch trees, any .cu/.cuh, the build definition, or the baseline
#       itself. Everything else pushes with IMP_VERIFY_SKIP_PERF=1, because on
#       this host a decode reading drifts several percent between sessions and a
#       gate that fires on a server-handler edit reports the box, not the change.
#
#   paired A/B (make verify-ab, AUDIT_arch_2026 H-3)
#       runs after the perf gate on the same diffs. The single arm above cannot
#       resolve a delta smaller than the host's own between-session movement
#       (4-6 % on one tree, threshold 8 %); the paired arm alternates origin/main
#       (imp:ab-<sha>, built once per sha) against imp:test in one session and
#       judges the mean paired decode delta. IMP_SKIP_AB=1 skips it.
#
#   roofline (tools/roofline/, per-kernel %-of-peak) has no automated arm: CI
#       has no GPU runner and roofline.yml only re-parses committed history. A
#       diff under src/compute/ or src/exec/ gets a reminder with the age of the
#       newest history run; `make roofline-measure` is the manual step (H-2).
#
# The peak-VRAM gate stays on in both tiers: own_peak_mb is byte-identical
# across repeat runs, so it cannot produce the false positive this split exists
# to remove, and it costs almost nothing (measured 36 s full, 18 s without the
# perf gate).
#
# The release gate (scripts/check-release.sh) always runs everything.
# Override with: git push --no-verify   (use sparingly — see CLAUDE.md)
set -uo pipefail

REMOTE="$1"
URL="$2"
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

SOURCE_RE='^(src/|include/|tools/|tests/|scripts/|CMakeLists\.txt|cmake/|.*\.cmake$)'
PERF_RE='^(src/(compute|exec|quant|runtime|model)/|.*\.(cu|cuh)$|cmake/|CMakeLists\.txt|tests/perf_baseline)'

# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
NEEDS_VERIFY=0
NEEDS_PERF=0
NEEDS_ROOFLINE=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ] && continue   # delete
    if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
        # New branch — diff against upstream merge-base or main
        BASE=$(git merge-base "$LOCAL_SHA" origin/main 2>/dev/null || echo "")
        [ -z "$BASE" ] && BASE=$(git rev-list --max-parents=0 "$LOCAL_SHA" | head -1)
    else
        BASE="$REMOTE_SHA"
    fi
    FILES=$(git diff --name-only "$BASE" "$LOCAL_SHA" 2>/dev/null || true)
    [ -z "$FILES" ] && continue
    # Documentation cannot move a number or break a kernel, wherever it lives.
    # Without this, src/compute/CLAUDE.md matches PERF_RE and a docs-only push
    # pays the full perf gate — which then reports the host, not the change.
    #
    # Python neither: scripts/verify.sh invokes no .py at all (checked, not
    # assumed), so nothing a Python edit can touch reaches the tests, the perf
    # gate or the smoke prompts. tools/ and tests/ are full of it — the gate
    # scripts and the API contract suite — and SOURCE_RE matches those
    # directories by prefix. Same reasoning as the pre-commit filter (#1723).
    #
    # .hook joined them 2026-08-31 on the same check: these two files are read
    # by `make install-hooks` and by nothing else - not verify.sh, not the
    # build, not a test. Editing THIS file used to demand the full GPU gate,
    # which then reports the host rather than the change; what actually guards
    # the pair is guard_precommit_filter / guard_verify_filter in the CPU lane.
    FILES=$(echo "$FILES" | grep -vE '\.(md|py|hook)$|^tools/mutation/' || true)
    # Same reasoning one level down for scripts/*.sh: `^scripts/` in SOURCE_RE
    # is right for verify.sh and the guard scripts CMake registers as ctests,
    # and wrong for the 17 that verify.sh's path never reaches (ci_static_gates,
    # check-release, the bench harnesses). The membership test lives in
    # verify_touches.sh so the hook and its guard read one source.
    FILES=$(echo "$FILES" | while read -r f; do
        case "$f" in
            scripts/*.sh) "$ROOT/scripts/verify_touches.sh" "$f" >/dev/null 2>&1 && echo "$f" ;;
            *) echo "$f" ;;
        esac
    done)
    [ -z "$FILES" ] && continue
    echo "$FILES" | grep -qE "$SOURCE_RE" && NEEDS_VERIFY=1
    echo "$FILES" | grep -qE "$PERF_RE"   && NEEDS_PERF=1
    echo "$FILES" | grep -qE '^src/(compute|exec)/' && NEEDS_ROOFLINE=1
done

if [ "$NEEDS_VERIFY" -eq 0 ]; then
    echo "pre-push: no source changes, skipping verify"
    exit 0
fi

# Cheap static gates first (seconds, no GPU, no build): everything that would
# otherwise surface only in CI, one full roundtrip after the push. Both
# 2026-08-25 "File size" reds were the lane pin, and the 2026-08-26 #1782
# scheduler split went red in CI on a roadmap.md citation — each class below
# has cost a roundtrip at least once. All six selections together measure
# ~2 s; only `kernels` (needs a built artifact) and `hygiene` (subsumes
# citations via check-release.sh and runs the full release checklist) stay
# CI-side.
if [ -x "$ROOT/scripts/ci_static_gates.sh" ] || [ -f "$ROOT/scripts/ci_static_gates.sh" ]; then
    if ! bash "$ROOT/scripts/ci_static_gates.sh" filesize lanes entrypoint alloc launchguards docs citations; then
        echo "pre-push: static gates failed (see above) - fix or push --no-verify"
        exit 1
    fi
fi

# Both tiers below run kernels, so neither can judge anything on a busy card.
# Checked after the "no source changes" exit above: a docs-only push must not
# wait for a card it never touches.
# Guarded: an installed hook outlives the branch it came from, and a checkout
# that predates this script must still run the gate rather than die on it.
if [ -x "$ROOT/scripts/require_free_gpu.sh" ]; then
    "$ROOT/scripts/require_free_gpu.sh" "pre-push" || exit 1
fi

# Roofline (per-kernel %-of-peak, tools/roofline/) has no automated arm: CI has
# no GPU runner and roofline.yml only re-parses committed history, so a kernel
# diff is compared against nothing unless someone measures. Say so, with the
# age of the newest run, where the diff is being pushed (AUDIT_arch_2026 H-2).
if [ "$NEEDS_ROOFLINE" -eq 1 ] && [ -s "$ROOT/tools/roofline/history/index.jsonl" ]; then
    _rl_run="$(tail -1 "$ROOT/tools/roofline/history/index.jsonl" | sed -n 's/.*"run_id": *"\([^"]*\)".*/\1/p')"
    _rl_date="$(echo "$_rl_run" | sed -n 's/^[0-9a-f]*_\([0-9]\{8\}\)_.*/\1/p')"
    _rl_age=""
    if [ -n "$_rl_date" ]; then
        _rl_age="$(( ( $(date -u +%s) - $(date -u -d "$_rl_date" +%s 2>/dev/null || date -u +%s) ) / 86400 )) days old"
    fi
    echo "pre-push: diff touches src/compute or src/exec; the roofline history's newest run is"
    echo "          ${_rl_run:-none} (${_rl_age:-age unknown}). Nothing measures it for you: run"
    echo "          'make roofline-measure && make roofline-regress' if this diff should move a kernel class."
fi

if [ "$NEEDS_PERF" -eq 1 ]; then
    echo "pre-push: source changes touch the measured paths → make verify-fast (with perf gate)"
    make -s verify-fast || exit 1
    if [ "${IMP_SKIP_AB:-0}" = "1" ]; then
        echo "pre-push: paired A/B skipped (IMP_SKIP_AB=1)"
        exit 0
    fi
    echo "pre-push: paired A/B against origin/main → make verify-ab"
    exec make -s verify-ab
fi

echo "pre-push: source changes outside the measured paths → make verify-fast (no perf gate)"
echo "          run the perf gate anyway with: make verify-fast"
export IMP_VERIFY_SKIP_PERF=1
exec make -s verify-fast
